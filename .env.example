# Configuración LOCAL de Docker Compose. No reutilizar las claves de demo fuera del laboratorio.
DB_NAME=miniaula_db
DB_USER=miniaula
DB_PASSWORD=miniaula_local
DB_PORT=5432
API_PORT=4000
WEB_PORT=8080
